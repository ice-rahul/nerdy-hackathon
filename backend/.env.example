# Required.
ANTHROPIC_API_KEY=

# Per-IP limit on /generate. 30/minute is a dev-convenience default —
# tighten to 5/minute (or lower) before a public deploy.
GENERATE_RATE_LIMIT=30/minute

# Comma-separated list of extra allowed CORS origins (add the deployed
# frontend's URL here at deploy time). localhost:3000/127.0.0.1:3000 are
# always allowed on top of this.
CORS_ALLOWED_ORIGINS=

# Only needed to run backend/scripts/generate_exercise1_assets.py — not
# required to run the app itself.
HF_TOKEN=
